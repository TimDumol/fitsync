{
  "expo": {
    "name": "FitSync",
    "slug": "fitsync",
    "scheme": "fitsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": false }],
      "expo-sqlite",
      "expo-web-browser",
      "./plugins/withGarminChaquopy",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fitsync.mobile"
    }
  }
}
